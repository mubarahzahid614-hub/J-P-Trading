@page "/buyer/reviews"
@layout BuyerLayout
@inject AuthService Auth
@inject StoreService StoreSvc

<PageTitle>Reviews | J.P Trading</PageTitle>

<h2>Reviews</h2>

<div class="detail-grid">
    <div class="card">
        <h3>Write a review</h3>

        @if (!delivered.Any())
        {
            <div class="alert alert-info">You can review a vehicle after your order is delivered.</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-error">@error</div>
            }
            @if (!string.IsNullOrEmpty(success))
            {
                <div class="alert alert-info">@success</div>
            }

            <div class="form-group">
                <label>Vehicle</label>
                <select class="form-control" @bind="vehicle">
                    <option value="">Select a delivered vehicle</option>
                    @foreach (var o in delivered)
                    {
                        <option value="@o.VehicleTitle">@o.VehicleTitle (Order #@o.Id)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Rating</label>
                <select class="form-control" @bind="rating">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Very poor</option>
                </select>
            </div>
            <div class="form-group">
                <label>Comment</label>
                <textarea class="form-control" rows="4" @bind="comment"></textarea>
            </div>
            <button class="btn btn-primary" @onclick="Submit">Submit review</button>
        }
    </div>

    <div>
        @if (!reviews.Any())
        {
            <div class="alert alert-info">You have not written any reviews yet.</div>
        }
        @foreach (var r in reviews)
        {
            <div class="card" style="margin-bottom:14px">
                <b>@r.VehicleTitle</b>
                <div class="stars">@(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))</div>
                <p>@r.Comment</p>
                <span class="small muted">@r.CreatedAt.ToString("dd MMM yyyy")</span>
            </div>
        }
    </div>
</div>

@code {
    private List<Order> delivered = new();
    private List<Review> reviews = new();
    private string vehicle = "";
    private int rating = 5;
    private string comment = "";
    private string error = "";
    private string success = "";

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var u = Auth.CurrentUser;
        if (u == null) return;
        delivered = StoreSvc.OrdersFor(u.Email).Where(o => o.Status == "Delivered").ToList();
        reviews = StoreSvc.ReviewsFor(u.Email);
    }

    private void Submit()
    {
        error = "";
        success = "";

        if (vehicle == "" || string.IsNullOrWhiteSpace(comment))
        {
            error = "Please select a vehicle and write a comment.";
            return;
        }

        var u = Auth.CurrentUser!;
        StoreSvc.AddReview(u.Email, u.FullName, vehicle, rating, comment.Trim());
        vehicle = "";
        comment = "";
        rating = 5;
        success = "Thank you for your review.";
        Load();
    }
}