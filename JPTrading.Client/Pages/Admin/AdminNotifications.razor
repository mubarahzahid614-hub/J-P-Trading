@page "/admin/notifications"
@layout AdminLayout
@inject AuthService Auth
@inject StoreService StoreSvc

<PageTitle>Send Notification | J.P Trading</PageTitle>

<h2>Send Notification</h2>

<div class="card" style="max-width:600px">
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-error">@error</div>
    }
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-info">@success</div>
    }

    <div class="form-group">
        <label>Send to</label>
        <select class="form-control" @bind="target">
            <option value="all">All buyers</option>
            @foreach (var b in Auth.Buyers)
            {
                <option value="@b.Email">@b.FullName (@b.Email)</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label>Title</label>
        <input class="form-control" @bind="title" />
    </div>
    <div class="form-group">
        <label>Message</label>
        <textarea class="form-control" rows="4" @bind="message"></textarea>
    </div>
    <button class="btn btn-primary" @onclick="Send">Send notification</button>
</div>

@code {
    private string target = "all";
    private string title = "";
    private string message = "";
    private string error = "";
    private string success = "";

    private void Send()
    {
        error = "";
        success = "";

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(message))
        {
            error = "Please fill in title and message.";
            return;
        }

        var recipients = target == "all"
            ? Auth.Buyers.Select(b => b.Email).ToList()
            : new List<string> { target };

        foreach (var email in recipients)
            StoreSvc.AddNotification(email, title.Trim(), message.Trim());

        success = $"Notification sent to {recipients.Count} buyer(s).";
        title = "";
        message = "";
    }
}