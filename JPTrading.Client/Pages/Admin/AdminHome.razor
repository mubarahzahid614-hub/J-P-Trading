@page "/admin"
@layout AdminLayout
@inject AuthService Auth
@inject StoreService StoreSvc
@inject VehicleService VehicleSvc

<PageTitle>Admin Dashboard | J.P Trading</PageTitle>

<h2>Admin Dashboard</h2>
<p class="muted">Overview of your store.</p>

<div class="grid-4">
    <div class="card stat"><b>@VehicleSvc.GetAll().Count</b><span>Total vehicles</span></div>
    <div class="card stat"><b>@VehicleSvc.GetAll().Count(v => v.Status == "Available")</b><span>Available vehicles</span></div>
    <div class="card stat"><b>@StoreSvc.Orders.Count</b><span>Total orders</span></div>
    <div class="card stat"><b>@StoreSvc.Orders.Count(o => o.Status == "Requested")</b><span>New purchase requests</span></div>
    <div class="card stat"><b>@Auth.Buyers.Count</b><span>Registered buyers</span></div>
    <div class="card stat"><b>@StoreSvc.Inquiries.Count(i => string.IsNullOrEmpty(i.Reply))</b><span>Open inquiries</span></div>
</div>

<div class="card" style="margin-top:24px">
    <div class="row-between">
        <h3>Latest orders</h3>
        <a href="admin/orders">Manage orders</a>
    </div>

    @if (!StoreSvc.Orders.Any())
    {
        <p class="muted">No orders yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Order</th><th>Buyer</th><th>Vehicle</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var o in StoreSvc.Orders.OrderByDescending(x => x.CreatedAt).Take(5))
                    {
                        <tr>
                            <td>#@o.Id</td>
                            <td>@o.BuyerName</td>
                            <td>@o.VehicleTitle</td>
                            <td><StatusBadge Status="@o.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap">
    <a class="btn btn-primary" href="admin/vehicles/new">+ Add vehicle</a>
    <a class="btn btn-navy" href="admin/orders">View orders</a>
    <a class="btn btn-outline" href="admin/inquiries">Reply to inquiries</a>
</div>