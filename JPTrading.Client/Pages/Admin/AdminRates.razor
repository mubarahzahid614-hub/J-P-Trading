@page "/admin/rates"
@layout AdminLayout
@inject CurrencyService CurrencySvc

<PageTitle>Currency Rates | J.P Trading</PageTitle>

<h2>Currency Rates and Duty</h2>
<p class="muted">Changes apply immediately on the vehicle pages and the currency converter.</p>

<div class="card" style="margin-top:16px">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Country</th><th>Currency</th><th>1 ¥ =</th><th>Duty %</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in CurrencySvc.Countries)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Currency</td>
                        <td><input type="number" step="any" class="form-control form-sm" @bind="c.RatePerJpy" /></td>
                        <td><input type="number" step="any" class="form-control form-sm" @bind="c.DutyPercent" /></td>
                        <td><button class="btn btn-danger btn-sm" @onclick="() => CurrencySvc.RemoveCountry(c)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card" style="margin-top:20px">
    <h3>Add a country</h3>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-error">@error</div>
    }

    <div class="form-grid">
        <div class="form-group"><label>Country name</label><input class="form-control" @bind="name" /></div>
        <div class="form-group"><label>Currency code</label><input class="form-control" placeholder="e.g. PKR" @bind="code" /></div>
        <div class="form-group"><label>Rate (1 ¥ =)</label><input type="number" step="any" class="form-control" @bind="rate" /></div>
        <div class="form-group"><label>Duty %</label><input type="number" step="any" class="form-control" @bind="duty" /></div>
    </div>
    <button class="btn btn-primary" @onclick="Add">Add country</button>
</div>

@code {
    private string name = "";
    private string code = "";
    private decimal rate;
    private decimal duty;
    private string error = "";

    private void Add()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(code) || rate <= 0)
        {
            error = "Enter a name, a currency code and a rate greater than 0.";
            return;
        }

        CurrencySvc.AddCountry(new Country
        {
            Name = name.Trim(),
            Currency = code.Trim().ToUpper(),
            RatePerJpy = rate,
            DutyPercent = duty
        });

        name = "";
        code = "";
        rate = 0;
        duty = 0;
    }
}