@page "/admin/users"
@layout AdminLayout
@inject AuthService Auth
@inject StoreService StoreSvc
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Users | J.P Trading</PageTitle>

<h2>Registered Buyers</h2>

<div class="card" style="margin-top:16px">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Name</th><th>Email</th><th>Country</th><th>Orders</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Auth.Buyers)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@u.Country</td>
                        <td>@StoreSvc.OrdersFor(u.Email).Count</td>
                        <td><button class="btn btn-danger btn-sm" @onclick="() => Remove(u)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private async Task Remove(AppUser u)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Remove {u.FullName}?"))
            Auth.RemoveBuyer(u.Email);
    }
}